# The evidence store is an append-only log whose rows are proven
# byte-identical to what was written (tools/evidence_store.py). With
# core.autocrlf, checkout turned old rows CRLF while new ones stayed LF,
# so the working copy was not the bytes the hashes describe.
data/evidence/*.jsonl text eol=lf
data/evidence/index.json text eol=lf
# The normalized model (Phase 4) is rebuilt byte for byte by
# tools/migrate.py --check; checkout must not change its bytes either.
data/model/** text eol=lf
# The generated application data (Phase 5) is checked byte for byte against
# the model by tools/build-app-data.py --check; checkout must not change it.
data/app/** text eol=lf
# The document-date audit (historical M2) is checked byte for byte by
# tools/extract-document-dates.py --check and read by the migration.
data/history/** text eol=lf
