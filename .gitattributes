# The evidence store is an append-only log whose rows are proven
# byte-identical to what was written (tools/evidence_store.py). With
# core.autocrlf, checkout turned old rows CRLF while new ones stayed LF,
# so the working copy was not the bytes the hashes describe.
data/evidence/*.jsonl text eol=lf
data/evidence/index.json text eol=lf
# The normalized model (Phase 4) is rebuilt byte for byte by
# tools/migrate.py --check; checkout must not change its bytes either.
data/model/** text eol=lf
# The generated application data (Phase 5) is checked byte for byte against
# the model by tools/build-app-data.py --check; checkout must not change it.
data/app/** text eol=lf
# The document-date audit (historical M2) is checked byte for byte by
# tools/extract-document-dates.py --check and read by the migration.
data/history/** text eol=lf
# The M3 candidate audit is checked byte for byte by tools/extract-historical-m3.py --check.
data/audit/historical-m3-*.jsonl text eol=lf
# The data-gap register is checked byte for byte by tools/build-data-gap-register.py --check.
data/audit/data-gap-register.jsonl text eol=lf
# The M3.2 recovery audit is read by the migration and checked byte for byte.
data/audit/m32-recovery-candidates.jsonl text eol=lf
# The M3.3 source plan is checked byte for byte by tools/m33-source-plan.py --check.
data/audit/m3.3-source-acquisition-plan.jsonl text eol=lf
# The M3.4A mapping proposals are checked byte for byte by tools/m34a-mapping-audit.py --check.
data/audit/m3.4a-mapping-proposals.jsonl text eol=lf
# The M3.4B application manifest is read by the migration and checked byte for byte.
data/audit/m3.4b-mapping-application.jsonl text eol=lf
# The M3.5 held-document review is read by the migration and checked byte for byte.
data/audit/m3.5-held-document-review.jsonl text eol=lf
# The M3.6A rerun outputs are checked byte for byte by tools/m36a-rerun.py --check.
